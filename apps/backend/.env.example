DATABASE_URL=postgresql://spaceos:spaceos@localhost:5432/spaceos
REDIS_URL=redis://localhost:6379/0
# 교통 예상시간 — 서버 전용 키. 각 제공사 콘솔에서 길찾기 사용 권한을 활성화한다.
# 카카오모빌리티: https://developers.kakaomobility.com/guide/navi-api/start
# ODsay: https://lab.odsay.com/guide/guide?platform=web (서버 호출/IP 허용 설정)
KAKAO_MOBILITY_API_KEY=
ODSAY_API_KEY=
# 24시간 외부 호출 상한(두 수단 조회는 최대 2회). 프로세스별이며 재시작하면 초기화된다.
TRAVEL_DAILY_CAP_PER_INSTANCE=1000
CORS_ORIGINS=["http://localhost:5173"]
# [계정층] 실행 환경. 비우면 자동 판정한다 — Cloud Run 은 K_SERVICE 를 심으므로 prod 로 잡힌다.
# dev 가 아니면 아래 JWT_SECRET 이 기본값일 때 **앱이 아예 안 뜬다**(fail closed).
APP_ENV=
# [계정층] JWT 서명 키 — 반드시 배포 환경마다 고유한 무작위 값으로 채울 것.
# 기본값(config.py 의 "dev-only-change-me") 그대로 배포하면 누구나 토큰을 위조할 수 있다.
# 생성 예: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
# [계정층] 구글 로그인 — GCP 콘솔 OAuth 클라이언트 ID(웹). 비우면 구글 로그인이 꺼진다(버튼 없음).
# 공개값이라 비밀이 아니다. 클라이언트 비밀(secret)은 쓰지 않는다 → docs/decision-lightweight-first-2026-10-05.md §1
GOOGLE_CLIENT_ID=
# [계정층] 네이버·카카오 로그인 전용 앱 설정. 수집용 API 키를 재사용하지 않는다.
# 전 항목이 있어야 버튼/API가 켜진다. Secret은 서버 환경에만 설정하며 커밋하지 않는다.
# 카카오 Client Secret 사용을 활성화하고 동일 값을 등록한다.
# 각 개발자 콘솔에 아래 redirect URI를 정확히 등록한다(프래그먼트 없음).
# 정식: https://placeos.web.app/?social=naver 또는 ?social=kakao
# 로컬: http://localhost:5173/?social=naver 또는 ?social=kakao
# 먼저 `alembic upgrade head`로 social_identities 표를 생성한 뒤 설정을 활성화한다.
NAVER_LOGIN_CLIENT_ID=
NAVER_LOGIN_CLIENT_SECRET=
NAVER_LOGIN_REDIRECT_URI=
KAKAO_LOGIN_CLIENT_ID=
KAKAO_LOGIN_CLIENT_SECRET=
KAKAO_LOGIN_REDIRECT_URI=
# [운영] 관리자 API(X-Admin-Token) — /admin/coverage · /admin/usage(KPI② 파일럿 사용량).
# 미설정이면 관리자 라우터 전체가 403 이다(fail closed).
ADMIN_TOKEN=
# [Program] LLM 콘텐츠 생성 — Anthropic Claude (console.anthropic.com → API Keys)
# 선불 크레딧제라 잔액 0 이면 호출이 실패한다. Billing 에서 auto-reload + 사용량 알림을 켤 것.
LLM_API_KEY=
# 모델 override (비우면 config.py 기본값 claude-sonnet-5).
# claude-sonnet-5 = 기본·대량 생성 / claude-opus-5 = 품질 우선 시연 / claude-haiku-4-5 = 최저비용.
# Program 은 검증 브리프(텍스트)만 보낸다 — 사진 입력은 2026-09-17 대상 재정의로 빠졌다.
LLM_MODEL=

# ===== 네이버 클라우드 플랫폼 Maps (REST: Geocoding/Directions) =====
# Client ID(=Key ID)와 Client Secret 둘 다 필요. 실제 값은 apps/backend/.env 에 넣고 커밋 금지.
NAVER_MAPS_KEY_ID=9nbzrvj8qj
NAVER_MAPS_CLIENT_SECRET=__PUT_YOUR_CLIENT_SECRET_HERE__
